    char tm_mday[MDAY];	//当前月中的天
    char tm_mon[MON];	//当前月
    char tm_year[YEAR];	//当前年
    char tm_wday[WDAY];	//当前星期
    char tm_yday[YDAY];	//当前年的第几天
