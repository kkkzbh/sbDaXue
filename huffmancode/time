    char hms[HMS];	//时:分:秒   它大概是这个字符串
    char ymd[YMD];	//年 月 日   它大概是这个字符串
    char ymd_hms[YMD_HMS]; //年 月 日 时:分:秒
    char ymd_w_hms[YMD_W_HMS]; //年 月 日 星期 时:分:秒
    //如果要添加别的形式的时间 可以跟我说
}TIME;


