void mips_vm_init() // 宣告 mips_vm_init，供本文件或其他模块调用
{ // 打开新的语句块，把相关逻辑包在一起
 extern char KVPT[]; // 声明外部符号 KVPT，供链接阶段解析
 extern struct Env *envs; // 声明外部符号 *envs，供链接阶段解析
