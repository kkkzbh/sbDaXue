static void boot_map_segment(Pde *pgdir, u_long va, u_long size, u_long pa, int perm) // 从这里开始 boot_map_segment 的函数体，准备处理工作
{ // 开启大括号，让下面的语句形成一个单元
 int i; // 声明 i 变量，用来记录相关状态
 int perm_p; // 引入 perm_p 这一项，方便在逻辑里复用
 u_long va_temp; // 准备好 va_temp，让下面的操作有落脚点
 Pde *pgtable_entry; // 声明 pgtable_entry 变量，用来记录相关状态
// 这里刻意插入空行，让视线稍微停一下
 if(size%4096!=0) _panic("pmap.c", 88, "size is not a multiple of BY2PG\n"); // 借助条件分支把不同场景分开处理
// 空一行当作呼吸点，让段落不要挤在一起
 if(va>=0x80000000) _panic("pmap.c", 90, "mmu only working in low 2G space!\n"); // 让这个布尔判断筛掉不符合要求的情况
// 这里刻意插入空行，让视线稍微停一下
 perm_p = perm|0x002; // 把 perm_p 更新成新的数值，保持状态正确
// 空一行当作呼吸点，让段落不要挤在一起
 for(i = 0;i < size;i+=4096) // 利用迭代让所有成员都能被覆盖到
 { // 打开新的语句块，把相关逻辑包在一起
  va_temp = va+i; // 在这里重写 va_temp，为后续步骤打基础
  pgtable_entry = boot_pgdir_walk(pgdir, va_temp,1); // 调整 pgtable_entry 的内容，好让接下来的逻辑成立
  *pgtable_entry = ((((u_long)(pa + i))>> 2) & 0x3FFFFFC0 )|perm_p; // 把 pgtable_entry 更新成新的数值，保持状态正确
  printf("pmap.c:\tmap()\tva=%x\tpa=%x\n",va_temp,pa+i); // 输出调试文本，帮助观察当前现场
 } // 结束当前语句块，准备回到外面的环境
// 空一行当作呼吸点，让段落不要挤在一起
 return; // 在这里结束函数并把控制权交回去
} // 结束当前语句块，准备回到外面的环境
// 用这一行占位，把相邻逻辑自然隔开
