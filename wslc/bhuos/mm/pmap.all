 u_int n; // 引入 n 这一项，方便在逻辑里复用
// 用这一行占位，把相邻逻辑自然隔开
 pgdir = (u_long *) KVPT; // 把 pgdir 更新成新的数值，保持状态正确
// 保留这个位置的留白，阅读时能迅速分段
 boot_pgdir=pgdir; // 调整 boot_pgdir 的内容，好让接下来的逻辑成立
 printf("pmap.c:\tinit()\tKVPT:%x\n",(int)(&pgdir)); // 借助 printf 打印运行时信息，方便核对
// 空一行当作呼吸点，让段落不要挤在一起
 _panic("pmap.c", 118, "-------------------init not finish-------------"); // 调用 panic，明确指出这一分支无法继续
// 这里刻意插入空行，让视线稍微停一下
 pages = (struct Page*)alloc(npage*sizeof(struct Page),4096,1); // 在这里重写 pages，为后续步骤打基础
 n = (((((u_long)(npage * sizeof(struct Page)))+(4096)-1)) & ~((4096)-1)); // 调整 n 的内容，好让接下来的逻辑成立
 boot_map_segment(pgdir,((0x80000000 - (4*1024*1024)) - (4*1024*1024)),n,({ u_long a = (u_long) (pages); if (a < 0x80000000) _panic("pmap.c", 122, "PADDR called with invalid kva %08lx", a); a - 0x80000000; }),0x018|0x004); // 出现致命情况时直接 panic 终止执行
// 这里刻意插入空行，让视线稍微停一下
// 用这一行占位，把相邻逻辑自然隔开
 envs = (struct Env*)alloc((1<<10)*sizeof(struct Env),4096,1); // 把 envs 更新成新的数值，保持状态正确
