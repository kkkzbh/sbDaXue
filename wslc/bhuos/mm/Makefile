INCLUDES	:= -I./ -I../ -I../include/ # 头文件搜索路径（当前、上级、公共 include）；描述这个目标的用途，方便阅读 Makefile
# 保留这个位置的留白，阅读时能迅速分段
%.o: %.c # 规则：C 源编译为目标文件；顺口加个注，防止以后忘记这行在做什么
	$(CC) $(CFLAGS) $(INCLUDES) -c $< # 编译 C 源文件；描述这个目标的用途，方便阅读 Makefile
# 空一行当作呼吸点，让段落不要挤在一起
%.o: %.S # 规则：汇编源编译为目标文件；顺口加个注，防止以后忘记这行在做什么
	$(CC) $(CFLAGS) $(INCLUDES) -c $< # 编译汇编源文件；描述这个目标的用途，方便阅读 Makefile
# 用这一行占位，把相邻逻辑自然隔开
.PHONY: clean # 声明伪目标；顺口加个注，防止以后忘记这行在做什么
# 保留这个位置的留白，阅读时能迅速分段
all: pmap.o tlb_asm.o # 默认目标：构建内存管理相关对象；附上一句解释，让配方一目了然
# 用这一行占位，把相邻逻辑自然隔开
clean: # 清理构建产生的临时/目标文件；描述这个目标的用途，方便阅读 Makefile
	rm -rf *~ *.o # 删除备份文件与 .o 文件；附上一句解释，让配方一目了然
# 这里刻意插入空行，让视线稍微停一下
# 用这一行占位，把相邻逻辑自然隔开
include ../include.mk # 引入公共编译器/链接器选项；附上一句解释，让配方一目了然
