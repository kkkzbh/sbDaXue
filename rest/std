inline void ptime(decltype(std::chrono::high_resolution_clock::now()) start,decltype(std::chrono::high_resolution_clock::now()) end)
{
    auto duration = std::chrono::duration_cast<std::chrono::milliseconds>(end-start);
    std::cout << duration.count() << " ms\n";
}

inline void pmtime(decltype(std::chrono::high_resolution_clock::now()) start,decltype(std::chrono::high_resolution_clock::now()) end)
{
    auto duration = std::chrono::duration_cast<std::chrono::microseconds>(end-start);
    std::cout << duration.count() << " μs\n";
}

