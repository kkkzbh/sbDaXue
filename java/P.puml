@startuml

skinparam class {
    Padding 20
    Margin 10
}

scale 1000000 width

class menu {
    - static std::mutex mx
    - static std::condition_variable cv
    - static bool isrun
    - static bool end_pm
    - std::thread pm
    + menu()
    + ~menu()
    + static void pmenu()
    + static void pmenu_buf(std::ostringstream& os)
    + void oper()
    + static void pcompress(const std::function<bool(const std::string_view file, const std::string_view output)>& fun)
}

namespace progress {
    class progress {
        - static std::string compress_bar
        - static std::string decpress_bar
        - static std::mutex mux
        - static std::condition_variable cdv
        - static std::thread bar
        - static bool run
        - static bool end
        + static void pcompress()
        + static void pdecpress()
    }
}

class print {
    + print(const std::string_view fmt_str, Args&&... args)
    + print(Value&& i)
    + println(const std::string_view fmt_str, Args&&... args)
}

namespace sentence {
    class sentences {
        + static constexpr const char* sentences[]
    }
}


menu -- progress : uses
menu -- print : uses
print --> std::format : depends
print --> std::vformat : depends

namespace std {
    class vector {
        - std::size_t size
        + std::size_t capacity
    }
}

class priority_queue {
    - std::vector<T> a
    + priority_queue()
    + priority_queue(il: std::initializer_list<T>)
    + priority_queue(st: M_iterator, ed: M_iterator)
    + priority_queue(st: M_iterator, n: int)
    + priority_queue(vec: std::vector<T>&&)
    + push(const val: T&) -> void
    + push(val: T&&) -> void
    + emplace(Args&&...) -> void
    + top() -> T&
    + pop() -> void
    + size() const noexcept -> std::size_t
    + empty() const noexcept -> bool
    - adj_down(std::size_t it, T&& val) -> void
    - make() -> void
}

priority_queue --> std::vector : uses

namespace huftree {
    class huftree {
        +huftree(const std::array<uint64, ch_size>& feq)
        +operator=(huftree&& huf) noexcept -> huftree&
        +get_iterator() -> iterator
        +get_sum() const -> uint64
    }
}

namespace hufcode {
    class hufcode {
        +hufcode(const huftree& tree)
        +hufcode(std::ifstream& ifs)
        +operator[](unsigned char c) -> std::string&
        +operator[](const std::string& s) -> char
        +operator[](std::string&& s) -> char
    }
}

class map {
    +vec
    +cnt
    +sz
}

namespace write_read {
    class WriteRead {
        +write(const map<std::string, stkmem>& map, std::ofstream& ofs)
        +read(map<std::string, stkmem>& map, std::ifstream& ifs)
        +write(const Tree& tree, std::ofstream& ofs)
        +read(Tree& tree, std::ifstream& ifs)
    }
}

huftree::huftree -> priority_queue::priority_queue : use
hufcode::hufcode -> huftree::huftree : use
hufcode::create -> huftree::hufnode : use
hufcode::create -> hufcode::create : call

huftree::huftree -> huftree::operator= : call
huftree::get_iterator -> huftree::iterator : return
hufcode::create -> map::insert : call
hufcode::hufcode -> hufcode::create : call
hufcode::hufcode -> write_read::WriteRead::read : call

write_read::WriteRead::write -> map : access
write_read::WriteRead::read -> map : access
write_read::WriteRead::write -> huftree::huftree : access
write_read::WriteRead::read -> huftree::huftree : access


class string_buffer {
    push(data: const char*)
    to_int() : int
    move(size: int)
}

class compress {
    compress(file: std::string_view, output: std::string_view) : bool
}

class depress {
    depress(file: std::string_view, output: std::string_view) : bool
}

progress -- compress : bar
progress -- compress : end
progress -- compress : pcompress

progress -- depress : bar
progress -- depress : end
progress -- depress : pdecpress

compress -- huftree : word_frequency
compress -- huftree : huftree
compress -- hufcode : hufcode
compress -- progress : compress_bar
compress -- string_buffer : buf

depress -- huftree : huftree
depress -- hufcode : hufcode
depress -- progress : decpress_bar
depress -- string_buffer : buf

class hash<T> {
    operator()(str: T) : uint64
}

hash -- compress : operator(hash)
hash -- depress : operator(hash)

package "map" {
    class map<T, U, Hash>
    interface write
    interface read
    class M_iterator {
        - std::vector<std::vector<std::pair<T, U>>>* vec
        - std::pair<T, U>* ptr
        - uint64 index
        - uint64 pos
    }

    map ..> write : uses
    map ..> read : uses
    map --> M_iterator : has

    class M_iterator {
        value_type: std::pair<T, U>
        operator==(i1: M_iterator, i2: M_iterator): bool
        operator*(): value_type&
        operator->(): value_type*
        operator++(): M_iterator&
        operator++(int): M_iterator
    }

    map --> utility : uses
    map --> hash : uses
}

package "utility" {
    class utility
}

package "hash" {
    class hash<T>
    class hash<std::string>
    class hash<tuple>
}

map --> utility
map --> hash

package "string_buffer" {
    class string_buffer {
        - char s[buffer_size]
        - uint64 l
        - uint64 r
        - uint64 sz
    }

    class M_iterator {
        - char* s
        - char* ptr
        + operator<=>(ptr1: M_iterator, ptr2: M_iterator): std::strong_ordering
        + operator==(ptr1: M_iterator, ptr2: M_iterator): bool
        + operator->(): char*
        + operator*(): char
        + operator++(): M_iterator&
        + operator++(int): M_iterator
    }

    string_buffer --> M_iterator : has

    class string_buffer {
        + operator+=(str: const char*): string_buffer&
        + operator+=(c: const char): string_buffer&
        + operator bool(): bool
        + push(str: const char*): void
        + push(c: const char): void
        + ignore(): void
        + pop(): void
        + move(dis: uint64): void
        + get(): char
        + make(): std::string
        + to_int(): int
        + size(): uint64
        + empty(): bool
        + begin(): iterator
        + end(): iterator
    }

    class M_iterator {
        value_type: std::pair<T, U>
        operator==(i1: M_iterator, i2: M_iterator): bool
        operator*(): value_type&
        operator->(): value_type*
        operator++(): M_iterator&
        operator++(int): M_iterator
    }
}

