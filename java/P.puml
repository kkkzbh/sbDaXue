package "Concepts" {
    class comparable {
        + requires(a: T, b: T) { a < b } -> std::convertible_to<bool>
    }

    class hashable {
        + requires(a: T) { hash<T>{}(a) } -> std::convertible_to<uint64>
    }

    class contain_a {
        + requires(tree: T) { tree.a }
    }
}

