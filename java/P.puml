package "Compression Algorithms"  {
    class rle {
        + rle_compress(file: std::string_view, output: std::string_view = "../out.nt"): bool
        + rle_depress(file: std::string_view, output: std::string_view = "../de.znt"): bool
    }
    class "lz77" {
        + lz_compress(const std::string_view file, const std::string_view output = "../out.nt") : bool
        + lz_depress(const std::string_view file, const std::string_view output = "../de.znt") : bool
    }
    class "deflate"{
        + deflate_compress(file" const std::string_view file,const std::string_view output = "../out.nt") -> bool
        + deflate_depress(file" const std::string_view file,const std::string_view output = "../out.nt") -> bool
    }
}

