package "time.h" {


    class TIME {
        - char[4] tm_sec
        - char[4] tm_min
        - char[4] tm_hour
        - char[4] tm_mday
        - char[4] tm_mon
        - char[8] tm_year
        - char[4] tm_wday
        - char[8] tm_yday
        - char[4] tm_isdst
        - char[12] hms
        - char[16] ymd
        - char[28] ymd_hms
        - char[32] ymd_w_hms
    }


    class M_t {
        - TIME* tim
        + ~M_t()
    }

    class time {
        + refresh_time(TIM: TIME*) : TIME*
        + referesh() : TIME*
    }


    TIME -- char : tm_sec
    TIME -- char : tm_min
    TIME -- char : tm_hour
    TIME -- char : tm_mday
    TIME -- char : tm_mon
    TIME -- char : tm_year
    TIME -- char : tm_wday
    TIME -- char : tm_yday
    TIME -- char : tm_isdst
    TIME -- char : hms
    TIME -- char : ymd
    TIME -- char : ymd_hms
    TIME -- char : ymd_w_hms

    M_t -- TIME : tim

    time -- TIME : refresh_time()
    time -- TIME : referesh()

}

